CUDA_VISIBLE_DEVICES=#specify visible GPUs on your machine
FREESURFER_HOME=#where your freesurfer license is. needed for fmriprep
PROJECT_ROOT=#root directory to the project code
DATASETS_ROOT=#root directory to all the fmri datasets. Individual datasets should be located at $DATASETS_ROOT/myfmridataset
PYTHONPATH=#path to project root
TMP=#temporary directory for storage of intermediate files during fmriprep execution